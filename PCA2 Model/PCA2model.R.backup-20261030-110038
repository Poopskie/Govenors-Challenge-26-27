## =====================================================================
## 4. Quarterly panel with y/y growth
## =====================================================================
monthly <- can |>
  full_join(brent_m, by = "m") |>
  full_join(trim |> rename(trim = v) |> mutate(m = d), by = "m") |>
  arrange(m) |>
  filter(!is.na(m))

to_q <- function(df) {
  df |>
    mutate(q = floor_date(m, "quarter")) |>
    group_by(q) |>
    summarise(across(-m, mean, na.rm = TRUE), .groups = "drop")
}
Q <- to_q(monthly)

# y/y percent for price and wage series (index or $ levels -> growth)
Q <- Q |>
  mutate(across(c(cpi_all, cpi_food, cpi_store, cpi_gas,
                  ippi, rmpi, rmpi_oil, wage, brent),
                ~ 100 * (. / lag(., 4) - 1), .names = "{.col}_yy"))

X <- Q |>
  select(q, trim,
         ippi_yy, rmpi_yy, rmpi_oil_yy,      # cost pipeline
         cpi_food_yy, cpi_gas_yy,            # prices
         wage_yy)                            # wages
# add CSCE / BOS expectations later (they start 2014 / 1997)

## =====================================================================
## 5. PCA on the 2000-2019 training window (base version)
## =====================================================================
train <- X |> filter(year(q) %in% 2000:2019) |> select(-q, -trim) |> drop_na()

mu <- colMeans(train); s <- apply(train, 2, sd)
Z  <- scale(train, mu, s)
pc <- prcomp(Z)

round(pc$rotation[, 1], 3)                   # loadings: all same sign?
round(100 * summary(pc)$importance[2, 1])    # % variance explained by PC1

# project over the full sample (use complete rows for now)
full <- X |> drop_na() |> mutate(PC1 = as.numeric(
  scale(as.matrix(select(., -q, -trim)) %*% pc$rotation[, 1])))

## =====================================================================
## 6. Base forecast regression + plot
## =====================================================================
m1 <- lm(lead(trim, 1) ~ PC1 + trim, data = full)
summary(m1)

full |>
  ggplot(aes(q, PC1)) +
  geom_line() +
  geom_hline(yintercept = 1, linetype = "dashed", color = "red") +
  labs(title = "Second-round inflation pressure index (PC1)",
       subtitle = paste0("PC1 variance explained: ",
                         round(100 * summary(pc)$importance[2, 1]), "%"))
