## 3. Local files you already downloaded (robust readers)
## =====================================================================
## NOTE: your "CPI6months.csv", "rawmat6months.csv" etc. only contain the
## last ~6 months. That is nowhere near enough: PCA loadings must be
## estimated on 2000-2019. Sections 1-2 replace those files entirely.

## Brent from FRED (DCOILBRENTEU.csv) — FRED CSVs have metadata lines
## before the real header, so find the DATE row first.
read_fred <- function(path) {
  lines <- readLines(path)
  hdr   <- grep("^DATE,", lines)[1]
  read.csv(path, skip = hdr - 1, stringsAsFactors = FALSE)
}
brent_m <- read_fred("DCOILBRENTEU.csv") |>
  transmute(m = as.Date(DATE), brent = DCOILBRENTEU)

## NRCan weekly diesel (xlsx) — open it once to check the sheet layout,
## then adjust the range if needed:
