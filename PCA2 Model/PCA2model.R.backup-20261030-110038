## =====================================================================
## 1. Bank of Canada Valet: CPI-trim / CPI-median  (VERIFIED WORKING)
## =====================================================================
## WHY THE OLD CODE FAILED:
##   read.csv(url) |> mutate(d = as.Date(d)) |> rename(v = 2)
## (a) The Valet CSV columns are called `date` and `CPI_TRIM`, so
##     `mutate(d = as.Date(d))` errors: object 'd' not found.
## (b) `rename(v = 2)` errors because dplyr::rename() needs the OLD
##     column NAME on the right-hand side, not a position number.
## FIX: set both names directly with names(df) <- c("d","v"). No tidyverse
## gymnastics needed.

valet <- function(series, start = "1997-01-01") {
  url <- paste0("https://www.bankofcanada.ca/valet/observations/", series,
                "/csv?start_date=", start)
  df <- read.csv(url, stringsAsFactors = FALSE)
  names(df) <- c("d", "v")          # date, value
  tibble(d = as.Date(df$d), v = as.numeric(df$v))
}

trim   <- valet("CPI_TRIM")         # monthly y/y core inflation, target
cpi_md <- valet("CPI_MEDIAN")      # alternative target

## =====================================================================
## 2. StatCan: exact series, pulled by vector ID  (ALL VERIFIED)
## =====================================================================
## get_cansim_vector() downloads ONLY these series, which is much faster
## than pulling whole tables (the LFS wage table is a ~190 MB download).

vectors <- c(
  cpi_all   = "v41690973",    # CPI All-items, 2002=100, monthly
  cpi_food  = "v41690974",    # CPI Food
  cpi_store = "v41690975",    # CPI Food purchased from stores
  cpi_gas   = "v41691136",    # CPI Gasoline
  ippi      = "v1230995983",  # IPPI total, monthly since 1956
  rmpi      = "v1230998135",  # RMPI total, monthly since 1981
  rmpi_oil  = "v1230998136",  # RMPI crude energy products (oil channel)
  wage      = "v2132579"      # Avg hourly wage, all employees, 15+, monthly
)

sc <- get_cansim_vector(vectors, start_time = "1997-01")

# the value column is `val_norm` in current cansim versions; be defensive
vcol <- intersect(c("val_norm", "VALUE"), names(sc))[1]

can <- sc |>
  transmute(
    m    = as.Date(paste0(REF_DATE, "-01")),
    name = names(vectors)[match(VECTOR, vectors)],
    v    = .data[[vcol]]
  ) |>
  pivot_wider(names_from = name, values_from = v)

